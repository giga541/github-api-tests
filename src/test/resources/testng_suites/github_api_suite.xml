<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="GitHub API Test Suite" verbose="2" parallel="methods" thread-count="3">

    <test name="Endpoint 1 – GET /users/{username}">
        <classes>
            <class name="com.github.api.tests.GitHubApiTest">
                <methods>
                    <include name="testGetExistingUser"/>
                    <include name="testGetNonExistentUser"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Endpoint 2 – GET /repos/{owner}/{repo}">
        <classes>
            <class name="com.github.api.tests.GitHubApiTest">
                <methods>
                    <include name="testGetExistingRepository"/>
                    <include name="testGetNonExistentRepository"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Endpoint 3 – GET /repos/{owner}/{repo}/issues">
        <classes>
            <class name="com.github.api.tests.GitHubApiTest">
                <methods>
                    <include name="testGetRepoIssues"/>
                    <include name="testGetIssuesNonExistentRepo"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Endpoint 4 – GET /search/repositories">
        <classes>
            <class name="com.github.api.tests.GitHubApiTest">
                <methods>
                    <include name="testSearchRepositoriesWithValidQuery"/>
                    <include name="testSearchRepositoriesWithEmptyQuery"/>
                </methods>
            </class>
        </classes>
    </test>

    <test name="Endpoint 5 – GET /users/{username}/repos">
        <classes>
            <class name="com.github.api.tests.GitHubApiTest">
                <methods>
                    <include name="testGetUserRepos"/>
                    <include name="testGetReposForNonExistentUser"/>
                    <include name="testChainedUserToRepos"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
