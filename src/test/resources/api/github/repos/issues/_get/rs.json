<#-- 
  Freemarker comment:
  GitHub returns an array of issue objects.
  We validate that each item in the array has the expected structure.
  We use Carina's "skip" wildcard for values we don't want to hardcode.
  The test uses JSONCompareMode + ARRAY_CONTAINS to check partial array membership.
-->
[
  {
    "id": "type:Integer",
    "node_id": "skip",
    "url": "regex:https://api\\.github\\.com/repos/.*/issues/.*",
    "html_url": "regex:https://github\\.com/.*/issues/.*",
    "number": "type:Integer",
    "state": "regex:open|closed",
    "title": "skip",
    "body": "skip",
    "user": {
      "login": "skip",
      "id": "type:Integer",
      "type": "skip",
      "site_admin": "type:Boolean"
    },
    "labels": "skip",
    "assignee": "skip",
    "assignees": "skip",
    "comments": "type:Integer",
    "created_at": "regex:\\d{4}-\\d{2}-\\d{2}T.*",
    "updated_at": "regex:\\d{4}-\\d{2}-\\d{2}T.*",
    "closed_at": "skip"
  }
]
