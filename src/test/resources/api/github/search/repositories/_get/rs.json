        "login": "skip",
        "id": "type:Integer",
        "type": "skip",
        "site_admin": "type:Boolean"
      },
      "html_url": "regex:https://github\\.com/.*",
      "description": "skip",
      "fork": "type:Boolean",
      "url": "regex:https://api\\.github\\.com/repos/.*",
      "stargazers_count": "type:Integer",
      "watchers_count": "type:Integer",
      "forks_count": "type:Integer",
      "open_issues_count": "type:Integer",
      "language": "skip",
      "score": "skip"
    }
  ]
}
